__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Runtime products are reproducible from configs/manifests and can be large.
# Keep the one small, hash-bound all-29 motion bundle required by two preserved
# canonical plans; every other historical/runtime artifact stays ignored.
artifacts/*
!artifacts/studies/
artifacts/studies/*
!artifacts/studies/static_line_b_staged_v2/
artifacts/studies/static_line_b_staged_v2/*
!artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/
artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/*
!artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/
artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/*
!artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/motion_internal_evidence.json
!artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/final_all_internal/
artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/final_all_internal/*
!artifacts/studies/static_line_b_staged_v2/20260820_225546_staged-static-05-pre-motion-ptt-v1/motion_internal/final_all_internal/formal_motion_model.pt
analyses/
reports/generated/

# Successful public data remain eligible for versioning; runner bookkeeping does not.
pipeline_output/*/.runner_state/
pipeline_output/.v5_locks/
pipeline_output/.dashboard_requests/
cache/

# Reports are reproducible from pipeline_output and are intentionally local.
report_output/*
!report_output/.gitkeep
