{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m1.pipeline_config.v1",
  "title": "M1 deploy pipeline config / M1 部署配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "platform_profile_id",
    "input_contract_ref",
    "output_contract_ref",
    "runtime",
    "modules",
    "versions"
  ],
  "properties": {
    "schema_version": {"const": "m1.pipeline_config.v1"},
    "config_id": {"type": "string", "minLength": 1},
    "platform_profile_id": {"type": "string", "minLength": 1},
    "input_contract_ref": {"const": "m1.signal_input.v1"},
    "output_contract_ref": {"const": "m1.inference_output.v1"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "device", "threads", "allowed_dependencies"],
      "properties": {
        "engine": {"enum": ["python_numpy_scipy", "python_onnx_cpu", "hybrid_python_onnx_cpu"]},
        "device": {"const": "cpu"},
        "threads": {"type": "integer", "minimum": 1},
        "allowed_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["numpy", "scipy", "onnxruntime", "scikit-learn"]}
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "preprocessing",
        "motion_detector",
        "data_classifier",
        "quality_strategy",
        "feature_extractor",
        "classifier",
        "aggregation",
        "calibration"
      ],
      "properties": {
        "validation": {"$ref": "#/$defs/module_ref"},
        "preprocessing": {"$ref": "#/$defs/module_ref"},
        "motion_detector": {"$ref": "#/$defs/module_ref"},
        "data_classifier": {"$ref": "#/$defs/module_ref"},
        "quality_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_mode", "policy_id", "sqi_monitor_enabled", "signal_frontend_id"],
          "properties": {
            "action_mode": {"enum": ["sqi_gate", "coarse_denoise"]},
            "policy_id": {"type": "string", "minLength": 1},
            "sqi_monitor_enabled": {"const": true},
            "signal_frontend_id": {"type": "string", "minLength": 1}
          }
        },
        "feature_extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "feature_schema_id"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "feature_schema_id": {"type": "string", "minLength": 1}
          }
        },
        "classifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label_map_id"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "label_map_id": {"const": "frailty3.v1"}
          }
        },
        "aggregation": {"$ref": "#/$defs/module_ref"},
        "calibration": {"$ref": "#/$defs/module_ref"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["preprocessing_version", "motion_version", "sqi_version", "feature_schema_version", "classifier_version"]
    }
  },
  "$defs": {
    "module_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}

