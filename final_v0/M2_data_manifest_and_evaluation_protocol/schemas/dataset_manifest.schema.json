{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m2.dataset_manifest.row.v1",
  "title": "M2 dataset manifest row",
  "type": "object",
  "required": ["dataset_version_id", "subject_id", "class_id", "file_id", "relative_path", "role", "channels", "raw_fs_hz", "units", "inclusion_status", "reference_available"],
  "properties": {
    "dataset_version_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "class_id": {"type": "integer"},
    "class_name": {"type": "string"},
    "file_id": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "role": {"type": "string", "pattern": "^(B|R[1-4]|S[1-2]|W[1-2])$"},
    "channels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "raw_fs_hz": {"type": "number", "exclusiveMinimum": 0},
    "units": {"type": "object"},
    "inclusion_status": {"enum": ["included", "excluded", "hold"]},
    "inclusion_reason": {"type": "string"},
    "reference_available": {"type": "boolean"},
    "reference_type": {"type": ["string", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
