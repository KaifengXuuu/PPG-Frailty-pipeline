build/
dist/

# Private/raw datasets are supplied separately from the source distribution.
/PPG_Testing_05_01_2026
/physionet.org
/datasets/
/data/

# Runtime products are reproducible from configs/manifests and can be large.
# Keep the small, hash-bound all-29 and five-fold motion weights required by
# the supported reuse modes; other historical/runtime artifacts stay ignored.
artifacts/*
!artifacts/studies/
artifacts/studies/*
!artifacts/studies/static_line_b_staged_v2/
artifacts/studies/static_line_b_staged_v2/*
